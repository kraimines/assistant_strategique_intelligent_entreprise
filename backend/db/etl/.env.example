# ETL Pipeline Configuration Template
# Copy this file to .env and adjust values for your environment

# ============================================================================
# POSTGRESQL CONFIGURATION
# ============================================================================

# PostgreSQL Server Connection
POSTGRES_HOST=postgres        # "localhost" for local dev, "postgres" for Docker
POSTGRES_PORT=5432            # Default PostgreSQL port
POSTGRES_USER=talan           # Database user
POSTGRES_PASSWORD=talan_secret # Database password (change in production!)

# PostgreSQL Databases (one per domain)
POSTGRES_DB_HR=talan_hr       # HR domain database name
POSTGRES_DB_CRM=talan_crm     # CRM domain database name
POSTGRES_DB_ERP=talan_erp     # ERP domain database name

# ============================================================================
# NEO4J CONFIGURATION
# ============================================================================

# Neo4j Server Connection
NEO4J_URI=bolt://neo4j:7687       # "bolt://localhost:7687" for local dev
NEO4J_USER=neo4j                  # Neo4j user (usually 'neo4j')
NEO4J_PASSWORD=talan_neo4j        # Neo4j password (change in production!)

# Neo4j Database (if using version 5+ with multiple databases)
NEO4J_DBNAME=neo4j                # Database name (default is 'neo4j')

# ============================================================================
# ETL CONFIGURATION
# ============================================================================

# Data Directory (where Excel files are located)
DATA_DIR=./data                    # Relative path: ./data or absolute path: /home/user/data

# Logging Level
LOG_LEVEL=INFO                     # DEBUG, INFO, WARNING, ERROR

# Environment
ENVIRONMENT=development            # development, staging, production

# ============================================================================
# OPTIONAL: ADVANCED CONFIGURATION
# ============================================================================

# SQLAlchemy Pool Configuration (if using in Python)
# SQLALCHEMY_POOL_SIZE=5          # Number of connections to keep in pool
# SQLALCHEMY_ECHO=false           # Log all SQL statements (debug)

# Neo4j Session Configuration
# NEO4J_CONNECTION_POOL_SIZE=50   # Max connections in pool
# NEO4J_SESSION_TIMEOUT=30        # Session timeout in seconds

# ETL Batch Processing
# ETL_BATCH_SIZE=500              # Batch size for SQL upserts
# NEO4J_BATCH_SIZE=200            # Batch size for Neo4j UNWIND operations

# ============================================================================
# NOTES
# ============================================================================
# - All environment variables are OPTIONAL with sensible defaults
# - Uncomment optional variables if you need to customize them
# - In production, use proper secret management (AWS Secrets, HashiCorp Vault)
# - Never commit .env file with real passwords to version control
# - Use .env.local for local overrides (add to .gitignore)
